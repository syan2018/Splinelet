{
  "name": "splinelet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "desktop:dev": "vite --config vite.desktop.config.ts",
    "desktop:build": "vite build --config vite.desktop.config.ts",
    "desktop": "tauri dev",
    "desktop:bundle": "tauri build",
    "desktop:check": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "desktop:format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "build:all": "pnpm build && pnpm desktop:build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "check:all": "pnpm check && pnpm desktop:format:check && pnpm desktop:check && pnpm build:all",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node scripts/tests/run-unit.mjs",
    "test:core": "node scripts/tests/unit/test-construction-pipeline.mjs && node scripts/tests/unit/test-modifiers.mjs && node scripts/tests/unit/test-print-stack.mjs",
    "test:export": "node scripts/tests/unit/test-3mf.mjs && node scripts/tests/unit/test-bambu-3mf.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tauri-apps/api": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsts": "^2.12.1",
    "lucide-react": "1.31.0",
    "manifold-3d": "^3.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/workers-types": "5.20260918.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "2.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "type": "module"
}
