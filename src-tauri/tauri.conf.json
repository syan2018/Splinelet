{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splinelet",
  "version": "0.1.0",
  "identifier": "app.splinelet.desktop",
  "build": {
    "beforeDevCommand": "pnpm desktop:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm desktop:build",
    "frontendDist": "target/frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Splinelet",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
